changed_files="$(git diff-tree -r --name-only --no-commit-id ORIG_HEAD HEAD)"

if echo "$changed_files" | grep --quiet "pnpm-lock.yaml"; then
  echo "[post-merge] pnpm-lock.yaml changed — installing dependencies..."
  if ! pnpm install --frozen-lockfile; then
    echo ""
    echo "[post-merge] pnpm install failed after merge."
    echo ""
    echo "  - Resolve manually with:  pnpm install"
    echo "  - If the lockfile is out of sync, drop --frozen-lockfile."
    echo ""
    exit 1
  fi
fi